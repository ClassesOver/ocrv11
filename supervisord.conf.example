; Supervisor 配置文件
; 用于管理 OCR 服务的 Gunicorn 进程
; 配置文件路径可通过环境变量指定：SUPERVISOR_CONF_PATH

[unix_http_server]
file=/tmp/supervisor.sock   ; supervisor 的 socket 文件路径
chmod=0700                  ; socket 文件权限

[inet_http_server]
port=0.0.0.0:19009       ; supervisor 的 web 界面地址和端口（仅监听本地，避免外部访问）
username=supervisor         ; web 界面用户名
password=%2x9Kp#mL8$vR@nQ   ; web 界面密码（强密码，请妥善保管）

[supervisord]
logfile=/home/ubuntu/code/logs/supervisord.log    ; supervisor 主进程日志文件
logfile_maxbytes=50MB                 ; 日志文件最大大小
logfile_backups=10                    ; 保留的日志文件备份数量
loglevel=info                         ; 日志级别 (critical, error, warn, info, debug, trace, blather)
pidfile=/tmp/supervisord.pid          ; supervisor 主进程 PID 文件
nodaemon=false                        ; 是否在前台运行（false 表示后台运行）
minfds=1024                           ; 最小文件描述符数量
minprocs=200                          ; 最小进程数量
childlogdir=/home/ubuntu/code/logs    ; 子进程日志目录

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix:///tmp/supervisor.sock ; 使用 unix socket 连接

[program:ocr_service]
; 使用虚拟环境中的 gunicorn
command=/home/ubuntu/code/.venv/bin/gunicorn -c gunicorn.conf.py api:app
; 或者使用 Python 模块方式：command=/home/ubuntu/code/.venv/bin/python -m gunicorn -c gunicorn.conf.py api:app
directory=/home/ubuntu/code            ; 工作目录
user=ubuntu                            ; 运行用户（可根据实际情况调整）
autostart=true                         ; 是否自动启动
autorestart=true                       ; 是否自动重启 (true, false, unexpected)
startretries=3                         ; 启动失败重试次数
startsecs=10                           ; 启动后等待多少秒才认为启动成功
stopwaitsecs=10                        ; 停止时等待多少秒
stopasgroup=true                       ; 停止时同时停止整个进程组
killasgroup=true                       ; 杀死时同时杀死整个进程组
stdout_logfile=/home/ubuntu/code/logs/ocr_service_stdout.log    ; 标准输出日志
stdout_logfile_maxbytes=100MB          ; 标准输出日志最大大小
stdout_logfile_backups=5               ; 标准输出日志备份数量
stdout_capture_maxbytes=1MB            ; 捕获输出最大字节数
stderr_logfile=/home/ubuntu/code/logs/ocr_service_stderr.log    ; 标准错误日志
stderr_logfile_maxbytes=100MB          ; 标准错误日志最大大小
stderr_logfile_backups=5               ; 标准错误日志备份数量
stderr_capture_maxbytes=1MB            ; 捕获错误输出最大字节数
; 环境变量：包含虚拟环境的 bin 目录到 PATH 中
environment=PATH="/home/ubuntu/code/.venv/bin:/usr/local/bin:/usr/bin:/bin",PYTHONUNBUFFERED="1",VIRTUAL_ENV="/home/ubuntu/code/.venv"
priority=999                           ; 启动优先级（数字越大优先级越高）
numprocs=1                             ; 进程数量（通常为1）

; 如果需要运行多个服务，可以添加更多 [program:xxx] 配置块
; 例如：
; [program:ocr_service_worker]
; command=python worker.py
; directory=/app/code
; autostart=true
; autorestart=true
; ...

